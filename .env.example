# Copy to .env.local and fill in. Never commit real values.
# Validated at startup by src/lib/env (see docs/specs/phase-0-foundation.md).

# --- Public (exposed to the browser) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase project settings > API (local: printed by `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SENTRY_DSN=
# Serve public images through Supabase Storage image transformations (Supabase Pro). true on
# staging and production; leave false locally and in CI (originals are served as is).
NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORMS=false

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Supabase secret / service-role key (required; server only, used by src/lib/supabase/admin.ts).
# Local: SERVICE_ROLE_KEY or SECRET_KEY from `npx supabase status -o env`.
SUPABASE_SECRET_KEY=
# Set to true only after the Google provider is configured in Supabase Auth.
GOOGLE_OAUTH_ENABLED=false
# Serve the staff-only /admin/design-system review page in a production build (always on in dev).
# CI only (optionally Vercel Preview); never set it in the Vercel Production environment.
SHOW_DESIGN_SYSTEM=false
RESEND_API_KEY=
EMAIL_FROM=
SENTRY_DSN=
# At least 16 characters. Used by Vercel Cron routes (Phase 4).
CRON_SECRET=
# Upstash Redis REST API (console > database > REST API). Redirects are synced there when both
# are set; without them the sync is skipped and logged. Required in production from Phase 3.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Build only (CI / Vercel) ---
# Source-map upload to Sentry; leave empty locally (nothing is uploaded without a token).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Local development tools ---
# Password for the sample accounts created by `npm run seed:users` (at least 12 characters).
SEED_USER_PASSWORD=
