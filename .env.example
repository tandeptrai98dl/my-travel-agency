# Copy to .env.local and fill in. Never commit real values.
# Validated at startup by src/lib/env (see docs/specs/phase-0-foundation.md).

# --- Public (exposed to the browser) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase project settings > API (local: printed by `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Browser errors go to its ingest host, which the Content Security Policy allows (src/lib/csp.ts).
NEXT_PUBLIC_SENTRY_DSN=
# Serve public images through Supabase Storage image transformations (Supabase Pro). true on
# staging and production; leave false locally and in CI (originals are served as is).
NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORMS=false
# Cloudflare Turnstile (dashboard > Turnstile > site). Public forms (newsletter now, inquiries in
# Phase 5) need both keys, Upstash and Resend; without them the form shows a disabled state.
# Cloudflare's test keys work locally: site 1x00000000000000000000AA, secret
# 1x0000000000000000000000000000000AA (always pass).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Google Analytics 4 measurement ID (G-XXXXXXXXXX; ADR-039, owner item 10). Optional: without it
# nothing of Google's loads. With it, gtag.js loads only after a visitor grants "analytics" in the
# cookie banner, and the CSP allows the Google Analytics hosts. Set at build time (NEXT_PUBLIC_).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Supabase secret / service-role key (required; server only, used by src/lib/supabase/admin.ts).
# Local: SERVICE_ROLE_KEY or SECRET_KEY from `npx supabase status -o env`.
SUPABASE_SECRET_KEY=
# Set to true only after the Google provider is configured in Supabase Auth.
GOOGLE_OAUTH_ENABLED=false
# Serve the staff-only /admin/design-system review page in a production build (always on in dev).
# CI only (optionally Vercel Preview); never set it in the Vercel Production environment.
SHOW_DESIGN_SYSTEM=false
# Resend (resend.com > API keys) and a verified sender, e.g. "Brand <hello@example.com>".
# Without both, transactional email (newsletter confirmation) is a logged no-op.
RESEND_API_KEY=
EMAIL_FROM=
# Cloudflare Turnstile secret, paired with NEXT_PUBLIC_TURNSTILE_SITE_KEY above.
TURNSTILE_SECRET_KEY=
SENTRY_DSN=
# Bearer secret of the Vercel Cron routes /api/cron/* (health-checks, housekeeping,
# balance-reminders, departure-checks; schedules in vercel.json). At least 32 characters; required
# when VERCEL_ENV is production.
# Without it the routes answer 503 and nothing runs. Generate with: openssl rand -base64 48
CRON_SECRET=
# Optional heartbeat URL of an uptime monitor (https), pinged after every successful cron run so a
# stopped Vercel Cron alerts; "{job}" in it is replaced by the job name. Sentry Cron Monitors get
# check-ins too whenever SENTRY_DSN is set.
CRON_HEARTBEAT_URL=
# Upstash Redis REST API (console > database > REST API). Redirects saved in the admin are synced
# there and served by the proxy (src/proxy.ts) when both are set; without them both are skipped and
# logged. Required when VERCEL_ENV is production (startup fails without them).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Payments (docs/specs/phase-4-booking-payments.md). VERCEL_ENV is set by Vercel; only
# "production" takes real payments. VNPay sandbox keys from the merchant portal; leave both empty
# to hide VNPay. VNPAY_STUB=true (CI only, refused in production) replaces VNPay's payment page
# with a local page that signs its IPN with VNPAY_HASH_SECRET.
VERCEL_ENV=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_STUB=false
# Source addresses allowed to call the VNPay IPN (Phase 6 decision 2): comma-separated IPv4/IPv6
# addresses or CIDR ranges, checked against the first x-forwarded-for hop. Empty = not enforced
# (local, CI, sandbox). Required in production while VNPay is on: VNPay's addresses from the
# merchant contract, or "unrestricted" only with the accepted exception in docs/SECURITY_REVIEW.md.
VNPAY_IPN_ALLOWED_IPS=
# Bank-transfer reconciliation webhook: sepay or casso, and its API key / secure token. Leave both
# empty and the webhook answers 503 (transfers are then recorded by an accountant).
BANK_WEBHOOK_PROVIDER=
BANK_WEBHOOK_SECRET=
# The same for the bank webhook: SePay publishes its addresses (README "Deployment"); Casso does not
# (use "unrestricted", recorded as an exception). Required in production while the webhook is on.
BANK_WEBHOOK_ALLOWED_IPS=
# HMAC key (32+ characters) of the guest checkout cookie. Without it online booking is off.
# Generate with: openssl rand -base64 48
BOOKING_ACCESS_SECRET=

# Deployment guards (Phase 6 decision 11, src/lib/env/deployment.ts). Leave empty locally. In
# Vercel, set both in every environment (Production and Preview), as comma-separated host names
# without scheme: the staging and the production Supabase hosts (<ref>.supabase.co), Upstash hosts
# and site domains. Production refuses to start on a staging host and needs its Supabase and
# Upstash hosts listed in PRODUCTION_HOSTS; a preview refuses every production host.
STAGING_HOSTS=
PRODUCTION_HOSTS=

# --- Build only (CI / Vercel) ---
# Source-map upload to Sentry; leave empty locally (nothing is uploaded without a token).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Local development tools ---
# Password for the sample accounts created by `npm run seed:users` (at least 12 characters).
SEED_USER_PASSWORD=
